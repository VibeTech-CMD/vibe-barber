# Supabase (opcional no Modo Demo — preencha para ativar backend real)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modo de demonstração (true = permite perfis de teste e pagamento Pix simulado)
VITE_DEMO_MODE=true

# URL configurável da marca desenvolvedora (Rodapé obrigatório Vibetech)
VITE_VIBETECH_URL=https://vibetech-cmd.github.io/VIBETECH/

# Base path para deploy (ex: /vibe-barber/ no GitHub Pages, / na Vercel ou Netlify)
VITE_BASE_PATH=/
